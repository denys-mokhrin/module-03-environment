{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Copy to .claude/settings.local.json for personal overrides. settings.local.json is gitignored.",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(docker compose *)",
      "Bash(docker ps)",
      "Bash(docker logs *)"
    ]
  },
  "env": {
    "LOG_LEVEL": "debug"
  }
}
